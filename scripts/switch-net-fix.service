[Unit]
Description=Switch Net Fix - local connectivity shim for retired China-region Nintendo Switch
Documentation=https://github.com/chengjungao/switch-net-fix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 监听 80 端口需要 root 或 CAP_NET_BIND_SERVICE
User=root
WorkingDirectory=/opt/switch-net-fix
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/switch-net-fix
ExecStart=/usr/bin/python3 -m switch_net_fix --port 80 --quiet
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
